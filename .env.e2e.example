# Nestlancer backend — e2e template (Infisical env: `e2e`)
# infisical export --env=e2e --format=dotenv > .env.infisical
# Docs: docs/guides/infisical.md
#
# Secrets are left blank — fill from Infisical. Never commit real .env files.
#
# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                         NESTLANCER — E2E ENVIRONMENT                         ║
# ║  System / e2e compose. Source of truth: Infisical slug `e2e`.                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  CORE / APP SETTINGS                                                       │
# └────────────────────────────────────────────────────────────────────────────┘
NODE_ENV=test
PORT=3000
GATEWAY_PORT=3000
APP_NAME=DemoApp-E2E
API_VERSION=v1
FRONTEND_URL=https://app.demo.example
CORRELATION_ID_HEADER=X-Request-ID

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  LOGGING                                                                   │
# └────────────────────────────────────────────────────────────────────────────┘
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=console
LOG_FILE_PATH=./logs/demo-app.log

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  DATABASE                                                                  │
# └────────────────────────────────────────────────────────────────────────────┘
DATABASE_URL=
DATABASE_READ_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=5
DATABASE_QUERY_TIMEOUT=5000

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  REDIS                                                                     │
# └────────────────────────────────────────────────────────────────────────────┘
REDIS_URL=
REDIS_CACHE_URL=
REDIS_PUBSUB_URL=
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=500

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  RABBITMQ                                                                  │
# └────────────────────────────────────────────────────────────────────────────┘
RABBITMQ_URL=
RABBITMQ_EXCHANGE_EVENTS=demo.events
RABBITMQ_EXCHANGE_WEBHOOKS=demo.webhooks
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_DELAY=1000
RABBITMQ_MAX_RETRIES=2

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  JWT / AUTH TOKENS                                                         │
# └────────────────────────────────────────────────────────────────────────────┘
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=2h
JWT_ALGORITHM=HS256
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_EXPIRES_IN=1800
JWT_REFRESH_PUBLIC_KEY=
JWT_REFRESH_PRIVATE_KEY=
JWT_REFRESH_EXPIRES_IN=7200
JWT_ISSUER=demo-auth-e2e
JWT_AUDIENCE=demo-api-e2e

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  CORS & RATE LIMITING                                                      │
# └────────────────────────────────────────────────────────────────────────────┘
CORS_ORIGINS=http://127.0.0.1:9000,http://127.0.0.1:9010
CORS_CREDENTIALS=true
CORS_MAX_AGE=0
RATE_LIMIT_ANONYMOUS=50000
RATE_LIMIT_ANONYMOUS_BURST=50000
RATE_LIMIT_USER=50000
RATE_LIMIT_USER_BURST=50000
RATE_LIMIT_PAID=50000
RATE_LIMIT_PAID_BURST=50000
RATE_LIMIT_ADMIN=50000
RATE_LIMIT_ADMIN_BURST=50000
RATE_LIMIT_WEBHOOK=50000

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  STORAGE (S3 / LOCAL)                                                      │
# └────────────────────────────────────────────────────────────────────────────┘
STORAGE_PROVIDER=s3
STORAGE_MAX_FILE_SIZE=104857600
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRY=300
STORAGE_BUCKET_PRIVATE=demo-media-private
STORAGE_BUCKET_PUBLIC=demo-media-public
STORAGE_BUCKET_AVATARS=demo-avatars
STORAGE_BUCKET_ATTACHMENTS=demo-attachments
STORAGE_BUCKET_QUOTES=demo-quotes
STORAGE_BUCKET_DELIVERABLES=demo-deliverables
STORAGE_BUCKET_REPORTS=demo-reports
STORAGE_BUCKET_PDFS=demo-pdfs
LOCAL_STORAGE_PATH=./data/demo-storage
LOCAL_STORAGE_URL=http://localhost:3000/files

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  Test: local SMTP (e.g. Mailpit). ZeptoMail is production-only.            │
# └────────────────────────────────────────────────────────────────────────────┘
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FROM_EMAIL=noreply@demo.example
FROM_NAME=Demo App E2E
REPLY_TO=support@demo.example

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  RAZORPAY                                                                  │
# └────────────────────────────────────────────────────────────────────────────┘
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  MEILISEARCH                                                               │
# └────────────────────────────────────────────────────────────────────────────┘
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  ENCRYPTION                                                                │
# └────────────────────────────────────────────────────────────────────────────┘
ENCRYPTION_KEY=

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/auth                                                             │
# └────────────────────────────────────────────────────────────────────────────┘
BCRYPT_SALT_ROUNDS=4
MAX_FAILED_LOGIN_ATTEMPTS=100
LOCKOUT_DURATION_MS=1000
FAILED_LOGIN_COOLDOWN_WINDOW_MS=60000
OTP_EXPIRES_IN_MS=600000
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS_TOKEN=demo-bypass-token
EMAIL_VERIFY_EXPIRES_IN=86400
PASSWORD_RESET_EXPIRES_IN=

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/blog                                                             │
# └────────────────────────────────────────────────────────────────────────────┘
POSTS_PER_PAGE=10
MAX_COMMENT_LENGTH=2000
COMMENT_EDIT_WINDOW_MINUTES=30
MAX_COMMENT_DEPTH=3
MAX_REVISIONS_PER_POST=50
READING_WPM=200
RSS_ITEMS_COUNT=20
VIEW_DEBOUNCE_HOURS=0
SPAM_SCORE_THRESHOLD=0.7

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/health                                                           │
# └────────────────────────────────────────────────────────────────────────────┘
HEALTH_CACHE_TTL=0
HEALTH_TIMEOUT_DB=2000
HEALTH_TIMEOUT_CACHE=1000
HEALTH_TIMEOUT_QUEUE=2000
HEALTH_TIMEOUT_STORAGE=3000
HEALTH_TIMEOUT_EXTERNAL=5000
HEALTH_THRESHOLD_MEMORY_HEAP=268435456
HEALTH_THRESHOLD_MEMORY_RSS=536870912
HEALTH_THRESHOLD_DISK_PERCENT=0.95
SERVICE_REGISTRY_URL=http://localhost:3000/api/v1/registry
HEALTH_E2E_DISABLE_AUTH=false

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/media                                                            │
# └────────────────────────────────────────────────────────────────────────────┘
CLAMAV_HOST=localhost
CLAMAV_PORT=3312
CDN_DOMAIN=cdn.demo.example

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/messaging                                                        │
# └────────────────────────────────────────────────────────────────────────────┘
MAX_MESSAGE_SIZE=10485760
MAX_ATTACHMENTS=10
MESSAGING_REDIS_URL=

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/notifications                                                    │
# └────────────────────────────────────────────────────────────────────────────┘
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:e2e@demo.local

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/payments                                                         │
# └────────────────────────────────────────────────────────────────────────────┘
DEFAULT_CURRENCY=INR
SUPPORTED_CURRENCIES=INR
RECEIPT_PDF_PREFIX=demo-receipts/
INVOICE_PDF_PREFIX=demo-invoices/
PAYMENT_DEFAULT_UPFRONT_PERCENT=50
PAYMENT_ENFORCEMENT_ENABLED=false
PAYMENT_ENFORCEMENT_CRON_MS=86400000
PAYMENT_REMINDER_SCHEDULER_ENABLED=false
PAYMENT_REMINDER_AFTER_DAYS=1
PAYMENT_REMINDER_MAX_COUNT=5
PAYMENT_REMINDER_CRON_MS=86400000
PAYMENT_RECONCILIATION_CRON_MS=86400000

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/portfolio                                                        │
# └────────────────────────────────────────────────────────────────────────────┘
MAX_IMAGES_PER_ITEM=20
MAX_TAGS_PER_ITEM=10
PUBLIC_CACHE_TTL=0
FEATURED_CACHE_TTL=0

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/progress                                                         │
# └────────────────────────────────────────────────────────────────────────────┘
MAX_DELIVERABLE_SIZE_MB=50
APPROVAL_WINDOW_DAYS=7
MAX_REVISIONS_PER_MILESTONE=3
MILESTONE_REVIEW_CRON_MS=3600000

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/projects                                                         │
# └────────────────────────────────────────────────────────────────────────────┘
PROJECTS_CONSUME_QUOTE_ACCEPTED=true
PROJECTS_CONSUME_PAYMENT_COMPLETED=true

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/quotes                                                           │
# └────────────────────────────────────────────────────────────────────────────┘
PDF_TEMPLATE_DIR=src/templates/pdf
DEFAULT_QUOTE_VALIDITY_DAYS=30

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/requests                                                         │
# └────────────────────────────────────────────────────────────────────────────┘
ATTACHMENT_MAX_SIZE=10485760
ATTACHMENT_MAX_COUNT=10
QUOTE_EXPIRATION_DAYS=14
QUOTE_EXPIRY_CRON_MS=3600000

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/users                                                            │
# └────────────────────────────────────────────────────────────────────────────┘
AVATAR_MAX_SIZE=5242880
GDPR_EXPORT_LIMIT_DAYS=30
SOFT_DELETE_GRACE_PERIOD_DAYS=30

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  services/webhooks                                                         │
# └────────────────────────────────────────────────────────────────────────────┘
CLOUDFLARE_WEBHOOK_SECRET=
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF_MULTIPLIER=1
WEBHOOK_DEAD_LETTER_TTL_DAYS=1
WEBHOOK_RAW_BODY_SIZE_LIMIT=1mb

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  GATEWAY                                                                   │
# └────────────────────────────────────────────────────────────────────────────┘
AUTH_SERVICE_URL=http://127.0.0.1:3001
USERS_SERVICE_URL=http://127.0.0.1:3002
PAYMENTS_SERVICE_URL=http://127.0.0.1:3003
WEBHOOKS_SERVICE_URL=http://127.0.0.1:3004
ADMIN_SERVICE_URL=http://127.0.0.1:3005
REQUESTS_SERVICE_URL=http://127.0.0.1:3006
QUOTES_SERVICE_URL=http://127.0.0.1:3007
PROJECTS_SERVICE_URL=http://127.0.0.1:3008
PROGRESS_SERVICE_URL=http://127.0.0.1:3009
MESSAGING_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:3011
MEDIA_SERVICE_URL=http://127.0.0.1:3012
PORTFOLIO_SERVICE_URL=http://127.0.0.1:3013
BLOG_SERVICE_URL=http://127.0.0.1:3014
CONTACT_SERVICE_URL=http://127.0.0.1:3015
HEALTH_SERVICE_URL=http://127.0.0.1:3016

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  WS-GATEWAY                                                                │
# └────────────────────────────────────────────────────────────────────────────┘
WS_PORT=3100

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  workers/analytics-worker                                                  │
# └────────────────────────────────────────────────────────────────────────────┘
HOURLY_CRON=0 * * * *
DAILY_CRON=0 2 * * *
WEEKLY_CRON=0 3 * * 1
CACHE_TTL_HOURLY=60
CACHE_TTL_DAILY=120
USE_READ_REPLICA=false

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  workers/audit-worker                                                      │
# └────────────────────────────────────────────────────────────────────────────┘
AUDIT_BATCH_SIZE=20
AUDIT_FLUSH_INTERVAL_MS=2000
AUDIT_MAX_BUFFER_SIZE=200
AUDIT_FALLBACK_FILE_PATH=./logs/demo-audit-fallback.jsonl
AUDIT_RETRY_ON_FAILURE=true
AUDIT_QUEUE_NAME=demo.audit.queue

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  workers/cdn-worker                                                        │
# └────────────────────────────────────────────────────────────────────────────┘
BATCH_WINDOW_MS=2000
MAX_BATCH_SIZE=10
RETRY_ON_RATE_LIMIT=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=demo-cloudflare-zone-id

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  workers/email-worker                                                      │
# └────────────────────────────────────────────────────────────────────────────┘
EMAIL_CONCURRENCY=2
TEMPLATES_PATH=./src/templates
EMAIL_IDEMPOTENCY_TTL=300

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  workers/media-worker                                                      │
# └────────────────────────────────────────────────────────────────────────────┘
MEDIA_CONCURRENCY=2
MEDIA_TEMP_DIR=/tmp/media-worker-e2e
MEDIA_WORKER_CLAMAV_HOST=localhost
MEDIA_WORKER_CLAMAV_PORT=3312
CLAMAV_TIMEOUT_MS=60000
WEBP_QUALITY=60
MAX_PROCESSING_TIME_MS=120000

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  workers/notification-worker                                               │
# └────────────────────────────────────────────────────────────────────────────┘
NOTIFICATION_WORKER_REDIS_HOST=127.0.0.1
NOTIFICATION_WORKER_REDIS_PORT=6382
NOTIFICATION_WORKER_REDIS_PASSWORD=
REDIS_PUBSUB_PREFIX=ws:demo-e2e:
NOTIFICATION_WORKER_VAPID_PUBLIC_KEY=
NOTIFICATION_WORKER_VAPID_PRIVATE_KEY=
NOTIFICATION_WORKER_VAPID_SUBJECT=mailto:e2e@demo.local
NOTIFICATION_CONCURRENCY=3

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  workers/outbox-poller                                                     │
# └────────────────────────────────────────────────────────────────────────────┘
POLLING_INTERVAL_MS=2000
BATCH_SIZE=50
LOCK_TTL_SECONDS=10
STALE_THRESHOLD_MINUTES=15
LEADER_LOCK_KEY=outbox:poller:lock:demo-e2e
OUTBOX_HOSTNAME=outbox-e2e-1
OUTBOX_MAX_RETRIES=3
OUTBOX_RETRY_BACKOFF_MS=500
OUTBOX_RETRY_BACKOFF_MAX_MS=10000

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  workers/webhook-worker                                                    │
# └────────────────────────────────────────────────────────────────────────────┘
OUTGOING_TIMEOUT_MS=5000
WEBHOOK_WORKER_MAX_RETRIES=3
BACKOFF_BASE_SECONDS=2
BACKOFF_MULTIPLIER=2

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  LIBS (EXTRA)                                                              │
# └────────────────────────────────────────────────────────────────────────────┘
OUTBOX_POLL_INTERVAL=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_EXCHANGE=demo.events
AUDIT_WORKER_BATCH_SIZE=20
AUDIT_WORKER_FLUSH_INTERVAL=2000

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  ADDITIONAL (from Infisical — not in .env.test.example)                    │
# └────────────────────────────────────────────────────────────────────────────┘
ADMIN_URL=https://admin.demo.example
CDN_PUBLIC_BASE_URL=https://cdn.demo.example
DEMO_API_URL=http://localhost:5000
DEMO_METRICS_URL=http://localhost:13000/metrics
E2E_APP_VPS_HOST=infra.demo.local
E2E_INFRA_HOST='infra.demo.local'
INFRA_PROBE_INTERVAL_MS=30000
INFRA_VPS_HOST=demo-infra-host.example
MAILPIT_API_URL=http://localhost:8025
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PASSWORD=
MAILPIT_UI_USER=demo
METRICS_BIND_HOST=0.0.0.0
METRICS_ENABLED=true
METRICS_HOST_PORT=29464
METRICS_PORT=9464
MIGRATION_DATABASE_URL=
RABBITMQ_EVENTS_EXCHANGE=demo.events
RABBITMQ_MANAGEMENT_URL=http://localhost:15672/
S3_CONSOLE_URL=http://localhost:9001
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=https://s3.demo.example
SLOW_REQUEST_MS=300
TRACING_ENABLED=false
TRAFFIC_INTERVAL_SEC=15
WORKER_SIM_INTERVAL_MS=10000
