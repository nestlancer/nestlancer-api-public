# Copy to .env.test for local unit/integration tests:
#   cp .env.test.example .env.test
# Replace empty placeholders with local/test values (never commit .env.test).
#
# For Docker/dev/prod/e2e stacks (full Infisical key sets), see:
#   .env.development.example  (Infisical `dev`)
#   .env.e2e.example          (Infisical `e2e`)
#   .env.production.example   (Infisical `prod`)
#   .env.example              (index / how to choose)

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                       NESTLANCER — TEST ENVIRONMENT                         ║
# ║                                                                            ║
# ║  Unit & integration tests. Isolated DB, minimal workers, fast timeouts.    ║
# ║  All infrastructure points to test-specific databases/indices.             ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                          CORE / APP SETTINGS                               │
# └────────────────────────────────────────────────────────────────────────────┘
NODE_ENV=test
PORT=0
GATEWAY_PORT=
APP_NAME=DemoApp-Test
API_VERSION=
FRONTEND_URL=http://localhost:4200
CORRELATION_ID_HEADER=

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                             LOGGING                                        │
# └────────────────────────────────────────────────────────────────────────────┘
LOG_LEVEL=warn
LOG_FORMAT=
LOG_OUTPUT=
LOG_FILE_PATH=./logs/demo-app.log

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                             DATABASE                                       │
# └────────────────────────────────────────────────────────────────────────────┘
DATABASE_URL=
DATABASE_READ_URL=
DATABASE_POOL_MIN=
DATABASE_POOL_MAX=
DATABASE_QUERY_TIMEOUT=

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                               REDIS                                        │
# └────────────────────────────────────────────────────────────────────────────┘
REDIS_URL=
REDIS_CACHE_URL=
REDIS_PUBSUB_URL=
REDIS_MAX_RETRIES=1
REDIS_RETRY_DELAY=100

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                             RABBITMQ                                       │
# └────────────────────────────────────────────────────────────────────────────┘
RABBITMQ_URL=amqp://127.0.0.1:5673/demo
RABBITMQ_EXCHANGE_EVENTS=demo.events
RABBITMQ_EXCHANGE_WEBHOOKS=webhooks.demo
RABBITMQ_PREFETCH=
RABBITMQ_RETRY_DELAY=
RABBITMQ_MAX_RETRIES=

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                          JWT / AUTH TOKENS                                 │
# └────────────────────────────────────────────────────────────────────────────┘
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=5m
JWT_REFRESH_EXPIRY=1h
JWT_ALGORITHM=HS256

JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_EXPIRES_IN=300
JWT_REFRESH_PUBLIC_KEY=
JWT_REFRESH_PRIVATE_KEY=
JWT_REFRESH_EXPIRES_IN=3600
JWT_ISSUER=demo-auth-test
JWT_AUDIENCE=demo-api-test

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                          CORS & RATE LIMITING                              │
# └────────────────────────────────────────────────────────────────────────────┘
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CORS_CREDENTIALS=true
CORS_MAX_AGE=

RATE_LIMIT_ANONYMOUS=
RATE_LIMIT_ANONYMOUS_BURST=
RATE_LIMIT_USER=
RATE_LIMIT_USER_BURST=
RATE_LIMIT_PAID=
RATE_LIMIT_PAID_BURST=
RATE_LIMIT_ADMIN=
RATE_LIMIT_ADMIN_BURST=
RATE_LIMIT_WEBHOOK=10000

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                          STORAGE (S3 / LOCAL)                               │
# └────────────────────────────────────────────────────────────────────────────┘
STORAGE_PROVIDER=
STORAGE_MAX_FILE_SIZE=
STORAGE_ALLOWED_MIME_TYPES=

# --- S3-compatible (test cloud storage) ---
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRY=60

# Canonical bucket names (used across all services/workers; test bucket init)
STORAGE_BUCKET_PRIVATE=demo-test-media-private
STORAGE_BUCKET_PUBLIC=demo-media-public
STORAGE_BUCKET_AVATARS=demo-avatars
STORAGE_BUCKET_ATTACHMENTS=demo-attachments
STORAGE_BUCKET_QUOTES=demo-quotes
STORAGE_BUCKET_DELIVERABLES=demo-deliverables
STORAGE_BUCKET_REPORTS=demo-reports
STORAGE_BUCKET_PDFS=demo-pdfs

# --- Local storage (fallback when cloud provider is unavailable) ---
LOCAL_STORAGE_PATH=./data/demo-storage
LOCAL_STORAGE_URL=http://localhost:3000/files

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                           EMAIL / MAIL                                     │
# │  Test: local SMTP (e.g. Mailpit). ZeptoMail is production-only.            │
# └────────────────────────────────────────────────────────────────────────────┘
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FROM_EMAIL=noreply@demo.example
FROM_NAME=Demo App
REPLY_TO=support@demo.example

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                           RAZORPAY                                         │
# └────────────────────────────────────────────────────────────────────────────┘
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                         MEILISEARCH                                        │
# └────────────────────────────────────────────────────────────────────────────┘
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# ┌────────────────────────────────────────────────────────────────────────────┐
# │                         ENCRYPTION                                         │
# └────────────────────────────────────────────────────────────────────────────┘
ENCRYPTION_KEY=


