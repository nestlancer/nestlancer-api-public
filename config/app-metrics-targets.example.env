# Infra VPS Prometheus scrape targets for Nestlancer backend (28 workloads).
# Generate live values: pnpm monitoring:targets
#
# Copy APP_METRICS_TARGETS to Infra VPS prod.env — use App VPS Tailscale IP, NOT 172.22.0.1

APP_VPS_HOST=<app-vps-tailscale-ip>
APP_METRICS_TARGETS=<app-vps-tailscale-ip>:13000:gateway,<app-vps-tailscale-ip>:13100:ws-gateway,<app-vps-tailscale-ip>:14001:auth,<app-vps-tailscale-ip>:14002:users,<app-vps-tailscale-ip>:14003:payments,<app-vps-tailscale-ip>:14004:webhooks,<app-vps-tailscale-ip>:14005:admin,<app-vps-tailscale-ip>:14006:requests,<app-vps-tailscale-ip>:14007:quotes,<app-vps-tailscale-ip>:14008:projects,<app-vps-tailscale-ip>:14009:progress,<app-vps-tailscale-ip>:14010:messaging,<app-vps-tailscale-ip>:14011:notifications,<app-vps-tailscale-ip>:14012:media,<app-vps-tailscale-ip>:14013:portfolio,<app-vps-tailscale-ip>:14014:blog,<app-vps-tailscale-ip>:14015:contact,<app-vps-tailscale-ip>:14016:health,<app-vps-tailscale-ip>:15001:analytics-worker,<app-vps-tailscale-ip>:15002:audit-worker,<app-vps-tailscale-ip>:15003:cdn-worker,<app-vps-tailscale-ip>:15004:document-worker,<app-vps-tailscale-ip>:15005:email-worker,<app-vps-tailscale-ip>:15006:export-worker,<app-vps-tailscale-ip>:15007:media-worker,<app-vps-tailscale-ip>:15008:notification-worker,<app-vps-tailscale-ip>:15009:outbox-poller,<app-vps-tailscale-ip>:15010:webhook-worker
