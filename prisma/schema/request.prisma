// =============================================================================
// Service Request Models
// =============================================================================

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  ACCEPTED
  REJECTED
  CONVERTED_TO_PROJECT
  CHANGES_REQUESTED
  CANCELLED
  EXPIRED_QUOTE
}

model ProjectRequest {
  id                    String                 @id @default(uuid(7))
  userId                String
  assigneeId            String?
  title                 String
  description           String
  category              String
  budgetMin             Int?
  budgetMax             Int?
  budgetCurrency        String                 @default("INR")
  budgetFlexible        Boolean                @default(false)
  preferredStartDate    DateTime?
  deadline              DateTime?
  timelineFlexible      Boolean                @default(false)
  requirements          String[]
  technicalRequirements Json?
  additionalInfo        String?
  timeframe             String?
  status                    RequestStatus          @default(DRAFT)
  referencePortfolioItemId  String?
  referencePortfolioSlug    String?
  servicePackageId          String?
  submittedAt               DateTime?
  deletedAt                 DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignee              User?                  @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  referencePortfolioItem PortfolioItem?        @relation("RequestPortfolioRef", fields: [referencePortfolioItemId], references: [id], onDelete: SetNull)
  quote                 Quote?
  statusHistory         RequestStatusHistory[]
  adminNotes            AdminNote[]
  attachments           RequestAttachment[]
  servicePackage        ServicePackage?       @relation(fields: [servicePackageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([assigneeId])
  @@index([servicePackageId])
  @@index([status])
  @@index([referencePortfolioItemId])
}

model RequestAttachment {
  id            String         @id @default(uuid(7))
  requestId     String
  filename      String
  fileUrl       String
  storageBucket String?
  storageKey    String?
  mimeType      String
  size          Int
  createdAt     DateTime       @default(now())
  request       ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model RequestStatusHistory {
  id        String         @id @default(uuid(7))
  requestId String
  status    RequestStatus
  note      String?
  createdAt DateTime       @default(now())
  request   ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model AdminNote {
  id        String         @id @default(uuid(7))
  requestId String
  authorId  String
  content   String
  createdAt DateTime       @default(now())
  request   ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([authorId])
}
