// =============================================================================
// User Domain Models
// =============================================================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
  PENDING_DELETION
}

enum ClientTier {
  NEW
  RETURNING
  VIP
}

model User {
  id               String       @id @default(uuid(7))
  email            String
  passwordHash     String
  firstName        String
  lastName         String
  avatar           String?
  phone            String?
  role             UserRole     @default(USER)
  status           UserStatus   @default(ACTIVE)
  emailVerified    Boolean      @default(false)
  marketingConsent Boolean      @default(false)
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  clientTier               ClientTier @default(NEW)
  totalProjectsCompleted   Int        @default(0)
  totalSpentPaise          Int        @default(0)
  creditBalancePaise       Int        @default(0)
  brandGuidelines          Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  authConfig          AuthConfig?
  preferences         UserPreference?
  sessions            Session[]
  requests            ProjectRequest[]
  assignedRequests    ProjectRequest[] @relation("RequestAssignee")
  clientProjects      Project[]       @relation("ClientProjects")
  adminProjects       Project[]       @relation("AdminProjects")
  payments            Payment[]
  paymentsVerified    Payment[]              @relation("PaymentVerifiedBy")
  paymentProofs       PaymentProof[]         @relation("PaymentProofUploadedBy")
  platformAccountsCreated PlatformPaymentAccount[] @relation("PlatformPaymentAccountCreatedBy")
  platformAccountsUpdated PlatformPaymentAccount[] @relation("PlatformPaymentAccountUpdatedBy")
  companyLegalProfilesCreated CompanyLegalProfile[] @relation("CompanyLegalProfileCreatedBy")
  companyLegalProfilesUpdated CompanyLegalProfile[] @relation("CompanyLegalProfileUpdatedBy")
  savedPaymentMethods SavedPaymentMethod[]
  messages            Message[]
  messageModerationEvents MessageModerationEvent[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  pushSubscriptions   UserPushSubscription[]
  mediaUploaded       Media[]
  blogPosts           BlogPost[]
  blogComments        BlogComment[]
  postLikes           PostLike[]
  postBookmarks       PostBookmark[]
  contactResponses    ContactResponseLog[]     @relation("ContactResponses")
  showcaseConsents    ProjectShowcaseConsent[]   @relation("ShowcaseConsents")
  timeEntries         TimeEntry[]                @relation("TimeEntries")
  auditLogs           AuditLog[]
  systemConfigs       SystemConfig[]
  adminNotes          AdminNote[]
  verificationTokens  VerificationToken[]
  authSessions        AuthSession[]
  quotes              Quote[]                  @relation("UserQuotes")
  createdQuotes       Quote[]                  @relation("CreatedQuotes")
  impersonationSessionsAsAdmin ImpersonationSession[] @relation("ImpersonationAdmin")
  impersonationSessionsAsTarget ImpersonationSession[] @relation("ImpersonationTarget")
  chatThreadsCreated          ChatThread[]            @relation("ChatThreadsCreated")
  chatThreadMemberships       ChatThreadMember[]
  chatThreadMemberStints      ChatThreadMemberStint[]
  chatThreadUserPrefs         ChatThreadUserPrefs[]
  documents                   GeneratedDocument[]     @relation("UserDocuments")
  triggeredDocuments          GeneratedDocument[]     @relation("TriggeredDocuments")
  portfolioLikes              PortfolioLike[]
  progressEntries             ProgressEntry[]         @relation("ProgressActors")

  @@index([role])
  @@unique([email], where: { deletedAt: null })
}

model AuthConfig {
  id                  String    @id @default(uuid(7))
  userId              String    @unique
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  mustChangePassword  Boolean   @default(false)
  backupCodes         Json?     @default("[]")
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id                   String   @id @default(uuid(7))
  userId               String   @unique
  notificationSettings Json?
  marketingSettings    Json?
  privacySettings      Json?
  theme                String   @default("system")
  timezone             String   @default("Asia/Kolkata")
  language             String   @default("en")
  currency             String   @default("INR")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(uuid(7))
  userId       String
  token        String   @unique
  ip           String?
  userAgent    String?
  deviceInfo   Json?
  locationData Json?
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(uuid(7))
  userId    String
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthSession {
  id        String   @id // Custom ID like sess2Fa_...
  userId    String
  type      String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
