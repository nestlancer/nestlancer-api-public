# Optional local overrides for reset (rarely needed).
# Object storage credentials come from Infisical → `.env.infisical` (`S3_*`).
#
#   bash prod-data/run-seed.sh --env=dev
#
# Copy only if you need to override S3_* without re-exporting Infisical:
#
#   cp prod-data/reset/config/.env.reset.example prod-data/reset/config/.env.reset
#
# Do NOT commit .env.reset.

# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
