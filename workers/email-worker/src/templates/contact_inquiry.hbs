<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#b45309;">
      Inbox
    </td>
  </tr>
  <tr>
    <td class="email-title" style="padding:0 0 16px;font-family:Arial,Helvetica,sans-serif;font-size:24px;line-height:30px;font-weight:700;color:#0a2540;">
      New contact form submission
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f8fafc" style="background-color:#f8fafc;border:1px solid #e2e8f0;">
        <tr>
          <td width="4" bgcolor="#f59e0b" style="width:4px;background-color:#f59e0b;font-size:0;line-height:0;">&nbsp;</td>
          <td style="padding:14px 16px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:24px;color:#334155;">
            <p style="margin:0 0 8px;"><strong style="color:#0a2540;">Ticket:</strong> {{ticketId}}</p>
            <p style="margin:0 0 8px;"><strong style="color:#0a2540;">From:</strong> {{name}} &lt;<a href="mailto:{{email}}" style="color:#0d9488;text-decoration:underline;">{{email}}</a>&gt;</p>
            <p style="margin:0;"><strong style="color:#0a2540;">Subject:</strong> {{subject}}</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#64748b;">
      Message
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="background-color:#ffffff;border:1px solid #e2e8f0;">
        <tr>
          <td style="padding:16px 16px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#334155;">
            {{message}}
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding:0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#64748b;font-style:italic;">
      Reply directly to this email to reach the visitor.
    </td>
  </tr>
</table>
