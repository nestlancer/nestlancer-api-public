<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#0d9488;">
      Support
    </td>
  </tr>
  <tr>
    <td class="email-title" style="padding:0 0 16px;font-family:Arial,Helvetica,sans-serif;font-size:26px;line-height:32px;font-weight:700;color:#0a2540;">
      We received your message
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 12px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:26px;color:#334155;">
      Hi {{name}},
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 20px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:26px;color:#334155;">
      Thanks for contacting <strong style="color:#0a2540;">{{companyName}}</strong>. Our team has your message and will follow up soon.
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f8fafc" style="background-color:#f8fafc;border:1px solid #e2e8f0;">
        <tr>
          <td width="4" bgcolor="#272a7a" style="width:4px;background-color:#272a7a;font-size:0;line-height:0;">&nbsp;</td>
          <td style="padding:16px 18px;">
            <p style="margin:0 0 4px;font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#64748b;">Ticket ID</p>
            <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:22px;line-height:28px;font-weight:700;color:#0a2540;">{{ticketId}}</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#64748b;">
      We typically respond within 24–48 hours. For urgent help, reply to this email or write to
      <a href="mailto:{{supportEmail}}" style="color:#0d9488;text-decoration:underline;">{{supportEmail}}</a>.
    </td>
  </tr>
</table>
