<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#0d9488;">
      Support reply
    </td>
  </tr>
  <tr>
    <td class="email-title" style="padding:0 0 16px;font-family:Arial,Helvetica,sans-serif;font-size:24px;line-height:30px;font-weight:700;color:#0a2540;">
      {{subject}}
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 12px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:26px;color:#334155;">
      Hi {{name}},
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 12px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#64748b;">
      Regarding ticket <strong style="color:#0a2540;">{{ticketId}}</strong>:
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f8fafc" style="background-color:#f8fafc;border:1px solid #e2e8f0;">
        <tr>
          <td width="4" bgcolor="#0d9488" style="width:4px;background-color:#0d9488;font-size:0;line-height:0;">&nbsp;</td>
          <td style="padding:16px 16px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#334155;">
            {{{message}}}
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#64748b;">
      — {{companyName}} Support
    </td>
  </tr>
</table>
