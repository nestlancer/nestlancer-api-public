<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#0d9488;">
      Account security
    </td>
  </tr>
  <tr>
    <td class="email-title" style="padding:0 0 16px;font-family:Arial,Helvetica,sans-serif;font-size:26px;line-height:32px;font-weight:700;color:#0a2540;">
      Verify your email
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 12px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:26px;color:#334155;">
      Hi {{userName}},
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 24px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:26px;color:#334155;">
      Thanks for joining <strong style="color:#0a2540;">{{companyName}}</strong>. Confirm this address so we can secure your account and send quote, payment, and project updates.
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:0 0 24px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td align="center" bgcolor="#0d9488" style="border-radius:8px;background-color:#0d9488;">
            <!--[if mso]>
            <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{verificationUrl}}" style="height:48px;v-text-anchor:middle;width:200px;" arcsize="17%" stroke="f" fillcolor="#0d9488">
              <w:anchorlock/>
              <center style="color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:700;">Verify email</center>
            </v:roundrect>
            <![endif]-->
            <!--[if !mso]><!-- -->
            <a href="{{verificationUrl}}" target="_blank" style="display:inline-block;padding:14px 28px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:700;line-height:20px;color:#ffffff !important;text-decoration:none;border-radius:8px;background-color:#0d9488;border:1px solid #0d9488;">Verify email</a>
            <!--<![endif]-->
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#64748b;">
      This link expires in <strong style="color:#0a2540;">{{expiresIn}}</strong>.
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:20px;color:#94a3b8;">
      Button not working? Paste this URL into your browser:
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 20px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:20px;word-break:break-all;">
      <a href="{{verificationUrl}}" style="color:#0d9488;text-decoration:underline;">{{verificationUrl}}</a>
    </td>
  </tr>
  <tr>
    <td style="padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#64748b;">
      Didn’t create an account? You can safely ignore this message.
    </td>
  </tr>
</table>
